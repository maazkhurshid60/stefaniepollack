# Copy to .env.local and fill in real values. Never commit .env.local.

# IDX Broker API — server-side only, used by API/serverless functions that
# proxy requests to https://api.idxbroker.com. Do NOT prefix with VITE_.
IDX_BROKER_ACCESS_KEY=

# Supabase — shared project across sites, safe to expose (RLS-enforced).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
